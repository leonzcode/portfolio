---
import BaseLayout from "../layouts/BaseLayout.astro";

const credentials = [
  "Snow Hydrology Research Intern, UC Santa Barbara Earth Research Institute",
  "3rd Place in Engineering at Golden Gate STEM Fair (ISEF-affiliated regional)",
  "DSWA Innovation Award, Diamond Challenge Finalist (LitterBot)",
  "COSMOS Machine Learning Cluster at UC San Diego",
  "USACO Gold Division",
  "AI Club Co-Founder & Vice President",
  "Robotics Team Code Lead",
];
---

<BaseLayout title="Leon Zhao">
  <section>
    <h1
      class="text-[32px] sm:text-[36px] font-semibold tracking-tight text-neutral-900 dark:text-neutral-50 mb-2 leading-tight"
    >
      Leon Zhao
    </h1>
    <p class="text-[14px] text-neutral-500 dark:text-neutral-500 mb-8">
      12th grader
    </p>

    <div class="space-y-5 text-[16px] leading-[1.7] text-neutral-700 dark:text-neutral-300">
      <p>
        I create physics-informed machine learning models to help solve
        environmental and natural-hazard problems. I am currently working on an
        avalanche forecaster that uses satellite data to estimate risk from
        snowpack, weather, and terrain data at a 2 to 5 km resolution. My model
        placed 3rd in Engineering at the ISEF-affiliated Golden Gate STEM Fair.
        I snowboarded for 8 years, and this project started as a way to bridge
        data science to the mountains I ride.
      </p>
      <p>
        This past summer I worked as a snow hydrology research intern at UC
        Santa Barbara's Earth Research Institute, reconstructing snow water
        storage for California's Cosumnes River watershed. The 2021 Caldor Fire
        burned its upper basin, and the work supported post-fire water supply
        research at Lawrence Berkeley National Laboratory. I found a precision
        bug in the forest canopy classification that had been inflating April 1
        snow estimates. That fix and several others I contributed were reviewed
        and merged into the public codebase.
      </p>
      <p>
        Outside of avalanche work, I was in charge of AI and software for
        LitterBot, an autonomous waste sorting robot that reached the Diamond
        Challenge Global Finals and won the Delaware Solid Waste Authority (DSWA)
        Innovation Award. I co-founded my school's AI Club and run a free global
        summer program teaching Python, Numpy, regression models, and neural
        networks.
      </p>
    </div>

    <a
      href="/ai"
      class="inline-flex items-center mt-8 px-5 py-2.5 rounded-md bg-neutral-900 dark:bg-neutral-50 text-white dark:text-neutral-900 text-[14px] font-medium hover:bg-neutral-800 dark:hover:bg-neutral-200 transition-colors"
    >
      See projects
    </a>

    <h2
      class="font-semibold text-[18px] text-neutral-900 dark:text-neutral-100 mt-14 mb-5 tracking-tight"
    >
      Headline credentials
    </h2>
    <ul class="space-y-2.5 text-[15px] text-neutral-700 dark:text-neutral-300">
      {
        credentials.map((c) => (
          <li class="flex gap-2.5 leading-relaxed">
            <span class="text-neutral-400 dark:text-neutral-600 shrink-0 select-none">—</span>
            <span>{c}</span>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
