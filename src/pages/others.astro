---
import ArrowRight from "@lucide/astro/icons/arrow-right";
import ChevronDown from "@lucide/astro/icons/chevron-down";
import Eye from "@lucide/astro/icons/eye";
import Heart from "@lucide/astro/icons/heart";
import Plus from "@lucide/astro/icons/plus";
import Search from "@lucide/astro/icons/search";
import Send from "@lucide/astro/icons/send";
import X from "@lucide/astro/icons/x";
import BaseLayout from "../layouts/BaseLayout.astro";
import OnlineCount from "../components/OnlineCount.astro";
import { otherProjects } from "../data/projects";

const searchText = (project: (typeof otherProjects)[number]) =>
  [project.title, project.description, project.tag, ...(project.tech ?? []), ...(project.story ?? [])]
    .filter(Boolean)
    .join(" ")
    .toLocaleLowerCase();
---

<BaseLayout
  title="Others · Leon Zhao"
  description="Browser-built worlds, puzzles, sports, and other experiments by Leon Zhao."
  wide
>
  <section class="others" aria-labelledby="others-title" data-others-catalog>
    <header class="catalog-heading">
      <div>
        <h1 id="others-title">Others</h1>
        <p class="catalog-intro">Worlds, puzzles, sports, and other browser experiments.</p>
      </div>
      <p class="catalog-count" role="status" aria-live="polite" aria-atomic="true" data-others-count>
        {otherProjects.length} projects
      </p>
    </header>

    <div class="catalog-toolbar">
      <div class="catalog-search">
        <Search size={18} aria-hidden="true" />
        <label class="sr-only" for="others-search">Search projects</label>
        <input id="others-search" type="search" placeholder="Search projects" maxlength="120" autocomplete="off" data-others-search />
        <button type="button" class="search-clear" aria-label="Clear search" title="Clear search" data-others-clear hidden>
          <X size={16} aria-hidden="true" />
        </button>
      </div>
      <div class="catalog-sort">
        <label class="sr-only" for="others-sort">Sort projects</label>
        <select id="others-sort" data-others-sort autocomplete="off">
          <option value="featured">Featured order</option>
          <option value="title">Title, A to Z</option>
          <option value="views">Most viewed</option>
          <option value="likes">Most liked</option>
        </select>
        <ChevronDown size={15} aria-hidden="true" />
      </div>
    </div>

    <div class="catalog-grid" data-others-list>
      {otherProjects.map((project, index) => (
        <article
          class="catalog-item"
          data-card
          data-index={index}
          data-key={project.socialKey}
          data-original-search={searchText(project)}
          data-others-item
        >
          <a class="project-link" href={project.detailHref}>
            <div class:list={["project-image", { "image-contain": project.slug === "leon-kart" }]}>
              <img
                src={project.image}
                alt=""
                width="640"
                height="400"
                loading={index < 3 ? "eager" : "lazy"}
                decoding="async"
                style={`object-position: ${project.imagePosition ?? "center"};`}
              />
            </div>
            <div class="project-heading">
              <h2 data-edit="title" data-edit-key={project.socialKey}>{project.title}</h2>
              <ArrowRight size={18} aria-hidden="true" />
            </div>
          </a>
          <p class="project-description" data-edit="desc" data-edit-key={project.socialKey}>{project.description}</p>
          <footer class="project-meta">
            {project.multiplayer && <OnlineCount project={project.slug} />}
            <span class="project-stats" data-others-stats hidden>
              <span><Eye size={13} aria-hidden="true" /><span data-others-views></span></span>
              <span><Heart size={13} aria-hidden="true" /><span data-others-likes></span></span>
            </span>
          </footer>
        </article>
      ))}
    </div>

    <div class="catalog-empty" data-others-empty hidden>
      <h2>No projects found</h2>
      <button type="button" class="text-command" data-others-reset><X size={15} aria-hidden="true" />Clear search</button>
    </div>

    <details class="suggestion" data-others-suggestion>
      <summary>Suggest a project <Plus size={18} aria-hidden="true" /></summary>
      <form class="suggestion-form" action="/api/suggest" method="post" data-others-form>
        <div class="suggestion-message">
          <label for="others-message">Your idea</label>
          <textarea id="others-message" name="message" rows="4" required maxlength="1000" placeholder="What should I build next?"></textarea>
        </div>
        <div class="suggestion-contact">
          <label for="others-email">Email <span>(optional)</span></label>
          <input id="others-email" name="email" type="email" autocomplete="email" maxlength="120" placeholder="you@example.com" />
          <button class="send-command" type="submit" data-others-send><Send size={15} aria-hidden="true" /><span>Send suggestion</span></button>
        </div>
        <div class="suggestion-trap" aria-hidden="true">
          <label for="others-website">Website</label>
          <input id="others-website" name="website" tabindex="-1" autocomplete="off" />
        </div>
      </form>
      <p class="suggestion-status" role="status" aria-live="polite" data-others-form-status hidden></p>
      <button type="button" class="text-command" data-others-another hidden><Plus size={15} aria-hidden="true" />Send another suggestion</button>
      <noscript><p><a href="/contact">Contact Leon</a></p></noscript>
    </details>
  </section>
</BaseLayout>

<script>
  import "../scripts/others";
</script>

<style>
  .others {
    --catalog-line: #e5e5e5;
    --catalog-soft: #fafafa;
    --catalog-muted: #737373;
    --catalog-ink: #171717;
    color: var(--catalog-ink);
    letter-spacing: 0;
  }
  :global(.dark) .others {
    --catalog-line: #303030;
    --catalog-soft: #171717;
    --catalog-muted: #a3a3a3;
    --catalog-ink: #fafafa;
  }
  .others [hidden] { display: none !important; }
  .catalog-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 30px; }
  h1 { margin: 0 0 8px; font-size: 36px; line-height: 1.2; font-weight: 600; }
  .catalog-intro { margin: 0; color: var(--catalog-muted); font-size: 14.5px; line-height: 1.6; }
  .catalog-count { margin: 0 0 3px; flex-shrink: 0; color: var(--catalog-muted); font: 12px/1.6 var(--font-mono); }
  .catalog-toolbar { display: flex; justify-content: space-between; gap: 16px; margin-bottom: 28px; }
  .catalog-search { display: flex; align-items: center; position: relative; width: min(100%, 440px); min-width: 0; border: 1px solid var(--catalog-line); border-radius: 6px; padding-left: 13px; color: var(--catalog-muted); }
  .catalog-search:focus-within { border-color: var(--catalog-ink); }
  .catalog-search input { min-width: 0; width: 100%; height: 44px; padding: 0 38px 0 10px; outline: none; font-size: 14px; color: var(--catalog-ink); background: transparent; }
  .catalog-search input:placeholder-shown { padding-right: 12px; }
  .catalog-search input::-webkit-search-cancel-button { appearance: none; }
  .search-clear { position: absolute; right: 5px; display: grid; place-items: center; width: 32px; height: 32px; border-radius: 4px; cursor: pointer; }
  .search-clear:hover { background: var(--catalog-soft); color: var(--catalog-ink); }
  .catalog-sort { position: relative; flex-shrink: 0; }
  .catalog-sort select { appearance: none; height: 46px; width: 174px; padding: 0 34px 0 13px; border: 1px solid var(--catalog-line); border-radius: 6px; background: transparent; font-size: 13px; cursor: pointer; }
  .catalog-sort select option { color: var(--catalog-ink); background: var(--catalog-soft); }
  .catalog-sort > :global(svg) { position: absolute; right: 12px; top: 15px; pointer-events: none; }
  .catalog-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 36px 24px; }
  .catalog-item { min-width: 0; border: 1px solid var(--catalog-line); border-radius: 8px; overflow: hidden; background: transparent; }
  .project-link { display: block; }
  .project-image { aspect-ratio: 16 / 10; overflow: hidden; background: var(--catalog-soft); border-bottom: 1px solid var(--catalog-line); }
  .project-image img { width: 100%; height: 100%; object-fit: cover; transition: transform 180ms ease; }
  .project-link:hover img { transform: scale(1.025); }
  .image-contain img { object-fit: contain; padding: 18px; }
  .project-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; padding: 18px 18px 0; }
  .project-heading h2 { margin: 0; min-height: 44px; font-size: 16px; line-height: 22px; font-weight: 600; overflow-wrap: anywhere; }
  .project-heading > :global(svg) { flex-shrink: 0; margin-top: 2px; color: var(--catalog-muted); transition: transform 150ms; }
  .project-link:hover .project-heading > :global(svg) { color: var(--catalog-ink); transform: translateX(3px); }
  .project-description { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden; margin: 8px 18px 20px; height: 63px; font-size: 14px; line-height: 21px; color: var(--catalog-muted); }
  .project-meta { display: flex; justify-content: space-between; align-items: center; gap: 8px; margin: 0 18px; padding: 12px 0; min-height: 43px; border-top: 1px solid var(--catalog-line); color: var(--catalog-muted); font-size: 11.5px; }
  .project-stats, .project-stats > span { display: inline-flex; align-items: center; gap: 5px; }
  .project-stats { gap: 12px; font-variant-numeric: tabular-nums; }
  .catalog-empty { padding: 70px 16px; text-align: center; }
  .catalog-empty h2 { margin-bottom: 12px; font-size: 18px; font-weight: 500; }
  .text-command { display: inline-flex; align-items: center; justify-content: center; gap: 7px; padding: 5px 0; font-size: 13px; cursor: pointer; }
  .text-command:hover { text-decoration: underline; text-underline-offset: 4px; }
  .suggestion { margin-top: 48px; border-top: 1px solid var(--catalog-line); border-bottom: 1px solid var(--catalog-line); padding: 0 0 4px; }
  .suggestion summary { display: flex; justify-content: space-between; align-items: center; padding: 21px 0 17px; font-size: 14px; font-weight: 500; list-style: none; cursor: pointer; }
  .suggestion summary::-webkit-details-marker { display: none; }
  .suggestion[open] summary > :global(svg) { transform: rotate(45deg); }
  .suggestion-form { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 22px; position: relative; padding: 4px 0 22px; }
  .suggestion-form label { display: block; margin-bottom: 8px; font-size: 12px; }
  .suggestion-form label span { color: var(--catalog-muted); }
  .suggestion-form input, .suggestion-form textarea { display: block; width: 100%; border: 1px solid var(--catalog-line); border-radius: 5px; padding: 10px 12px; background: transparent; color: var(--catalog-ink); font-size: 16px; line-height: 1.5; }
  .suggestion-form textarea { resize: vertical; min-height: 124px; max-height: 360px; }
  .suggestion-form input { height: 46px; }
  .send-command { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 42px; margin-top: 14px; padding: 9px 14px; border-radius: 5px; color: white; background: #171717; font-size: 13px; cursor: pointer; }
  :global(.dark) .send-command { background: #f5f5f5; color: #171717; }
  .send-command:disabled { opacity: 0.55; cursor: wait; }
  .suggestion-trap { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .suggestion-status { margin: 0 0 16px; font-size: 14px; line-height: 1.6; }
  .suggestion-status[data-state="error"] { color: #dc2626; }
  :global(.dark) .suggestion-status[data-state="error"] { color: #fca5a5; }
  .others a:focus-visible, .others button:focus-visible, .others select:focus-visible, .others summary:focus-visible, .suggestion-form input:focus-visible, .suggestion-form textarea:focus-visible { outline: 2px solid var(--catalog-ink); outline-offset: 4px; }
  @media (max-width: 1023px) { .catalog-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 639px) {
    h1 { font-size: 32px; }
    .catalog-heading { align-items: flex-start; flex-direction: column; gap: 8px; margin-bottom: 22px; }
    .catalog-toolbar { gap: 10px; }
    .catalog-search { flex: 1; }
    .catalog-search input { font-size: 16px; }
    .catalog-sort select { width: 142px; padding-left: 10px; font-size: 12px; }
    .catalog-grid { grid-template-columns: minmax(0, 1fr); gap: 24px; }
    .suggestion-form { grid-template-columns: minmax(0, 1fr); gap: 16px; }
  }
  @media (max-width: 379px) {
    .catalog-toolbar { flex-direction: column; }
    .catalog-search { width: 100%; flex: auto; }
    .catalog-sort select { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) { .others *, .others :global(svg) { transition: none !important; } }
</style>
