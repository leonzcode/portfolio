---
import BaseLayout from "../layouts/BaseLayout.astro";

const inputClasses =
  "w-full px-3 py-2 rounded-md border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-950 text-[14px] text-neutral-900 dark:text-neutral-100 placeholder:text-neutral-400 dark:placeholder:text-neutral-600 focus:outline-none focus:border-neutral-900 dark:focus:border-neutral-300 transition-colors";
const labelClasses =
  "block text-[13px] font-medium mb-1.5 text-neutral-800 dark:text-neutral-200";
---

<BaseLayout title="Contact · Leon Zhao">
  <section>
    <h1
      class="text-[32px] sm:text-[36px] font-semibold tracking-tight text-neutral-900 dark:text-neutral-50 mb-2 leading-tight"
    >
      Contact
    </h1>
    <p class="text-[14.5px] text-neutral-500 dark:text-neutral-500 mb-10">
      Reach out about research, collaborations, or feedback.
    </p>

    <!-- Inline error banner, hidden until JS shows it. role=alert so screen readers announce on appear. -->
    <div
      id="contact-error"
      role="alert"
      hidden
      class="mb-6 px-4 py-3 rounded-md border border-red-200 dark:border-red-900/50 bg-red-50 dark:bg-red-950/30 text-red-800 dark:text-red-200 text-[13.5px]"
    >
    </div>

    <!-- Success state: replaces the form when the message lands. role=status announces politely. -->
    <div
      id="contact-success"
      role="status"
      hidden
      class="px-5 py-6 rounded-md border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900/50"
    >
      <p class="text-[15px] font-medium text-neutral-900 dark:text-neutral-100 mb-1">
        Message sent.
      </p>
      <p class="text-[14px] text-neutral-600 dark:text-neutral-400 leading-relaxed">
        Thanks — I'll get back to you soon.
      </p>
    </div>

    <form
      id="contact-form"
      method="POST"
      action="/api/contact"
      class="space-y-5"
      aria-label="Contact form"
      novalidate
    >
      <div>
        <label for="name" class={labelClasses}>Name</label>
        <input
          id="name"
          name="name"
          type="text"
          required
          autocomplete="name"
          maxlength="100"
          class={inputClasses}
        />
      </div>

      <div>
        <label for="email" class={labelClasses}>Email</label>
        <input
          id="email"
          name="email"
          type="email"
          required
          autocomplete="email"
          maxlength="200"
          class={inputClasses}
        />
      </div>

      <div>
        <label for="message" class={labelClasses}>Message</label>
        <textarea
          id="message"
          name="message"
          rows="6"
          required
          maxlength="5000"
          class={`${inputClasses} resize-y`}
        ></textarea>
      </div>

      {/* Honeypot. Visually + physically hidden from humans, but a real DOM input
          that bots scraping for fields will happily fill. Server treats any non-empty
          value as bot-traffic. NOT display:none (some bots specifically skip those);
          off-screen position keeps it parseable but invisible. */}
      <div aria-hidden="true" class="absolute left-[-9999px] w-px h-px overflow-hidden">
        <label for="website">Website (leave empty)</label>
        <input
          id="website"
          name="website"
          type="text"
          tabindex="-1"
          autocomplete="off"
        />
      </div>

      <button
        id="contact-submit"
        type="submit"
        class="inline-flex items-center px-4 py-2 rounded-md bg-neutral-900 dark:bg-neutral-50 text-white dark:text-neutral-900 text-[13px] font-medium hover:bg-neutral-800 dark:hover:bg-neutral-200 disabled:opacity-60 disabled:cursor-not-allowed transition-colors"
      >
        <span data-label-idle>Send message</span>
        <span data-label-sending hidden>Sending…</span>
      </button>
    </form>
  </section>

  <script is:inline>
    (() => {
      const form = document.getElementById("contact-form");
      const submit = document.getElementById("contact-submit");
      const errorBox = document.getElementById("contact-error");
      const successBox = document.getElementById("contact-success");
      if (!form || !submit || !errorBox || !successBox) return;

      const idleLabel = submit.querySelector("[data-label-idle]");
      const sendingLabel = submit.querySelector("[data-label-sending]");

      function setSubmitting(submitting) {
        submit.disabled = submitting;
        idleLabel.hidden = submitting;
        sendingLabel.hidden = !submitting;
      }
      function showError(msg) {
        errorBox.textContent = msg;
        errorBox.hidden = false;
      }
      function clearError() {
        errorBox.hidden = true;
        errorBox.textContent = "";
      }
      function showSuccess() {
        form.hidden = true;
        successBox.hidden = false;
        successBox.scrollIntoView({ behavior: "smooth", block: "center" });
      }

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        clearError();

        const data = {
          name: form.name.value.trim(),
          email: form.email.value.trim(),
          message: form.message.value.trim(),
          website: form.website.value, // honeypot
        };

        if (!data.name || !data.email || !data.message) {
          showError("Please fill in name, email, and message.");
          return;
        }

        setSubmitting(true);
        try {
          const res = await fetch("/api/contact", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(data),
          });
          let payload = {};
          try {
            payload = await res.json();
          } catch {}
          if (res.ok && payload.ok) {
            showSuccess();
          } else {
            showError(payload.error || "Something went wrong. Please try again.");
            setSubmitting(false);
          }
        } catch {
          showError("Network error. Check your connection and try again.");
          setSubmitting(false);
        }
      });
    })();
  </script>
</BaseLayout>
