---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import { scienceProjects } from "../data/projects";
---

<BaseLayout title="Science · Leon Zhao" wide={true}>
  <section>
    <h1
      class="text-[32px] sm:text-[36px] font-semibold tracking-tight text-neutral-900 dark:text-neutral-50 mb-2 leading-tight"
    >
      Science
    </h1>
    <p class="text-[14.5px] text-neutral-500 dark:text-neutral-500 mb-10">
      Interactive science simulators, from ski resort terrain mapping to physics programs built alongside coursework in Physics 1 and 2.
    </p>
    <ProjectGrid projects={scienceProjects} />
  </section>
</BaseLayout>
