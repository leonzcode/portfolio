---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import { gameProjects } from "../data/projects";
---

<BaseLayout title="Games · Leon Zhao" wide={true}>
  <section>
    <h1
      class="text-[32px] sm:text-[36px] font-semibold tracking-tight text-neutral-900 dark:text-neutral-50 mb-2 leading-tight"
    >
      Games
    </h1>
    <p class="text-[14.5px] text-neutral-500 dark:text-neutral-500 mb-10">
      Browser games built as side projects: arcade, puzzles, and classics. Every
      one of them has a "Play online" button now, so you can be matched against
      someone else or share a world with whoever is playing at the same time.
    </p>
    <ProjectGrid projects={gameProjects} />
  </section>
</BaseLayout>
