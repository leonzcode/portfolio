---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectSocial from "../../components/ProjectSocial.astro";
import { aiProjects } from "../../data/projects";

export function getStaticPaths() {
  return aiProjects.map((p) => ({
    params: { slug: p.slug },
    props: { project: p },
  }));
}

const { project } = Astro.props;
const story = project.story ?? [project.description];
const tech = project.tech ?? [];
const screenshots = project.screenshots ?? [];
let playableHref: string | undefined;

// Same-tab nav when we control the destination (apps.leonzhao.dev — has a
// breadcrumb back to the portfolio). New-tab when the destination is off
// our infra (GitHub Pages projects can't be edited to add a back-link, so
// preserving the portfolio tab is the visitor's only way home).
let isExternalDemo = false;
if (project.href && project.href.startsWith("http")) {
  try {
    const host = new URL(project.href).hostname;
    const isOnLeonzhaoDomain = host.endsWith("leonzhao.dev");
    isExternalDemo = !isOnLeonzhaoDomain;
    if (isOnLeonzhaoDomain) {
      playableHref = project.href;
    }
  } catch {
    isExternalDemo = true; // unparseable URLs default to new-tab (safer)
  }
}
const hasEmbeddedPlayable = !!playableHref;
const hasExternalSource = !!project.href && !!playableHref;
---

<BaseLayout
  title={`${project.title} · Leon Zhao`}
  description={project.description}
  wide={true}
>
  <article>
    <a
      href="/ai"
      class="inline-flex items-center gap-1.5 text-[13px] text-neutral-500 dark:text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors mb-8 group"
    >
      <svg
        class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m15 18-6-6 6-6"></path>
      </svg>
      Back to AI
    </a>

    <header class="mb-10">
      <h1
        data-edit="title"
        data-edit-key={`ai/${project.slug}`}
        class="text-[32px] sm:text-[40px] font-semibold tracking-tight text-neutral-900 dark:text-neutral-50 mb-3 leading-tight"
      >
        {project.title}
      </h1>
      <p
        data-edit="desc"
        data-edit-key={`ai/${project.slug}`}
        class="text-[15px] leading-relaxed text-neutral-600 dark:text-neutral-400 max-w-2xl"
      >
        {project.description}
      </p>
      {
        ((project.href && project.href !== "#" && !hasEmbeddedPlayable) ||
          hasExternalSource ||
          project.repo) && (
          <div class="flex flex-wrap items-center gap-3 mt-6">
            {project.href && project.href !== "#" && !hasEmbeddedPlayable && (
              <a
                href={project.href}
                target={isExternalDemo ? "_blank" : undefined}
                rel={isExternalDemo ? "noopener noreferrer" : undefined}
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-md bg-neutral-900 dark:bg-neutral-50 text-white dark:text-neutral-900 text-[14px] font-medium hover:bg-neutral-800 dark:hover:bg-neutral-200 transition-colors"
              >
                Launch demo
                <svg
                  class="w-3.5 h-3.5"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M7 17 17 7" />
                  <path d="M7 7h10v10" />
                </svg>
              </a>
            )}
            {hasExternalSource && (
              <a
                href={project.href}
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-md bg-neutral-900 dark:bg-neutral-50 text-white dark:text-neutral-900 text-[14px] font-medium hover:bg-neutral-800 dark:hover:bg-neutral-200 transition-colors"
              >
                Open full screen
                <svg
                  class="w-3.5 h-3.5"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M8 3H5a2 2 0 0 0-2 2v3" />
                  <path d="M21 8V5a2 2 0 0 0-2-2h-3" />
                  <path d="M3 16v3a2 2 0 0 0 2 2h3" />
                  <path d="M16 21h3a2 2 0 0 0 2-2v-3" />
                </svg>
              </a>
            )}
            {project.repo && (
              <a
                href={project.repo}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-md border border-neutral-300 dark:border-neutral-700 text-neutral-900 dark:text-neutral-100 text-[14px] font-medium hover:bg-neutral-100 dark:hover:bg-neutral-800 hover:border-neutral-400 dark:hover:border-neutral-600 transition-colors"
              >
                View code
                <svg
                  class="w-3.5 h-3.5"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M7 17 17 7" />
                  <path d="M7 7h10v10" />
                </svg>
              </a>
            )}
          </div>
        )
      }
      <ProjectSocial slugKey={`ai/${project.slug}`} />
    </header>

    {
      hasEmbeddedPlayable && (
        <div class="w-full h-[78vh] min-h-[560px] rounded-md overflow-hidden border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 mb-12">
          <iframe
            src={playableHref}
            title={`${project.title} embedded app`}
            class="w-full h-full"
            loading="lazy"
          ></iframe>
        </div>
      )
    }

    {
      !hasEmbeddedPlayable && screenshots.length > 0 ? (
        <div class="space-y-4 mb-12">
          {screenshots.map((src) => (
            <img
              src={src}
              alt={`${project.title} screenshot`}
              class="w-full rounded-md border border-neutral-200 dark:border-neutral-800"
            />
          ))}
        </div>
      ) : !hasEmbeddedPlayable && project.image ? (
        <img
          src={project.image}
          alt={project.title}
          class="w-full mb-12 rounded-md border border-neutral-200 dark:border-neutral-800"
        />
      ) : !hasEmbeddedPlayable ? (
        <div class="aspect-[16/9] mb-12 rounded-md bg-neutral-100 dark:bg-neutral-900 border border-neutral-200/60 dark:border-neutral-800 flex items-center justify-center">
          <span class="font-mono text-[12px] tracking-wider uppercase text-neutral-400 dark:text-neutral-600">
            Screenshot placeholder
          </span>
        </div>
      ) : null
    }

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 lg:gap-14">
      <div class="lg:col-span-2 space-y-5 text-[16px] leading-[1.7] text-neutral-700 dark:text-neutral-300">
        {story.map((para) => <p>{para}</p>)}
      </div>

      <aside class="lg:col-span-1">
        {
          tech.length > 0 && (
            <>
              <h2 class="font-semibold text-[14px] tracking-wide uppercase text-neutral-500 dark:text-neutral-500 mb-4">
                Tech
              </h2>
              <ul class="space-y-2 text-[14.5px] text-neutral-700 dark:text-neutral-300">
                {tech.map((t) => (
                  <li class="flex gap-2.5 leading-relaxed">
                    <span class="text-neutral-400 dark:text-neutral-600 shrink-0 select-none">
                      —
                    </span>
                    <span>{t}</span>
                  </li>
                ))}
              </ul>
            </>
          )
        }
      </aside>
    </div>

    {
      project.repo && (
        <p class="mt-12 pt-6 border-t border-neutral-200 dark:border-neutral-800 text-[14.5px] leading-relaxed text-neutral-600 dark:text-neutral-400">
          The source code, training notes, and model files are available in the{" "}
          <a
            href={project.repo}
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium text-neutral-900 dark:text-neutral-100 underline underline-offset-2 decoration-neutral-300 dark:decoration-neutral-700 hover:decoration-neutral-900 dark:hover:decoration-neutral-100 transition-colors"
          >
            GitHub repo
          </a>
          .
        </p>
      )
    }
  </article>
</BaseLayout>
