---
import type { Project } from "../data/projects";
import ProjectCard from "./ProjectCard.astro";

interface Props {
  projects: Project[];
}

/* Every project is on the page. Hiding all but two behind a "View all" button asked
   a visitor to work out that there was more to see before they could see it, which
   is the wrong way round for a page whose whole job is to show the work. The search
   box stays: it narrows a long list, which is a different thing from hiding it. */
const { projects } = Astro.props;

const buildSearchIndex = (p: Project) =>
  [p.title, p.description, p.tag, ...(p.tech ?? []), ...(p.story ?? [])]
    .filter(Boolean)
    .join(" ")
    .toLowerCase();
// "games/ski": the key the server keeps the project's counts and edits under
const keyOf = (p: Project) => (p.detailHref ? p.detailHref.replace(/^\//, "").replace(/\/$/, "") : undefined);
---

<div data-project-section>
  <div class="mb-8">
    <div class="relative max-w-md">
      <svg
        class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-neutral-400 dark:text-neutral-500"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7" />
        <path d="m20 20-3.5-3.5" />
      </svg>
      <input
        type="search"
        data-search-input
        placeholder="Search projects"
        aria-label="Search projects"
        class="w-full pl-9 pr-3 py-2 text-[14.5px] rounded-md bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 text-neutral-900 dark:text-neutral-100 placeholder:text-neutral-400 dark:placeholder:text-neutral-500 focus:outline-none focus:border-neutral-400 dark:focus:border-neutral-600 transition-colors"
      />
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-10" data-grid>
    {
      projects.map((p, i) => (
        <div data-card data-search={buildSearchIndex(p)} data-index={i} data-key={keyOf(p)}>
          <ProjectCard {...p} />
        </div>
      ))
    }
  </div>

  <p data-no-results class="hidden mt-8 text-[14.5px] text-neutral-500 dark:text-neutral-500">
    No projects match your search.
  </p>

</div>

<script>
  import { SITE_API, cachedEdits, rememberEdits, applyText, applyOrder } from "../scripts/siteedits";
  // every card's views and likes, and the admin's edits, from one request for the whole page
  {
    const cards = [...document.querySelectorAll<HTMLElement>("[data-social-key]")];
    const keys = [...new Set(cards.map((c) => c.dataset.socialKey!))];
    const cats = [...new Set(keys.map((k) => k.split("/")[0]))];
    const grids = [...document.querySelectorAll<HTMLElement>("[data-grid]")];
    const edit = (text: Record<string, any>, order: Record<string, string[]>) => {
      for (const k of keys) applyText(k, text[k]);
      for (const g of grids) {
        const first = g.querySelector<HTMLElement>("[data-card][data-key]");
        if (first) applyOrder(g, order[first.dataset.key!.split("/")[0]]);
      }
      // the search finds a card by its edited words too
      for (const c of document.querySelectorAll<HTMLElement>("[data-card][data-key]")) {
        const t = text[c.dataset.key!];
        if (c.dataset.searchOrig === undefined) c.dataset.searchOrig = c.dataset.search || "";
        c.dataset.search = c.dataset.searchOrig + (t ? " " + [t.title, t.description].filter(Boolean).join(" ").toLowerCase() : "");
      }
    };
    const kept = cachedEdits();
    edit(kept.text, kept.order);
    if (keys.length) {
      fetch(SITE_API + "/stats?edits=1&slugs=" + encodeURIComponent(keys.join(",")), { cache: "no-store" })
        .then((r) => r.json())
        .then((res) => {
          // (a server from before the edits answers with the counts alone)
          const j = res && res.stats ? res.stats : res;
          if (res && res.stats) {
            edit(res.text || {}, res.order || {});
            rememberEdits(keys, cats, res.text || {}, res.order || {});
          }
          for (const c of cards) {
            const s = j && j[c.dataset.socialKey!];
            if (!s) continue;
            const bits = [s.views + (s.views === 1 ? " view" : " views"), s.likes + (s.likes === 1 ? " like" : " likes")];
            if (s.comments) bits.push(s.comments + (s.comments === 1 ? " comment" : " comments"));
            c.textContent = bits.join(" · ");
            c.hidden = false;
          }
        })
        .catch(() => {});
    }
  }
</script>
<script>
  document.querySelectorAll<HTMLElement>("[data-project-section]").forEach((section) => {
    const cards = Array.from(section.querySelectorAll<HTMLElement>("[data-card]"));
    const input = section.querySelector<HTMLInputElement>("[data-search-input]");
    const noResults = section.querySelector<HTMLElement>("[data-no-results]");

    const apply = () => {
      const q = (input?.value ?? "").trim().toLowerCase();
      let matches = 0;
      cards.forEach((card) => {
        const hit = !q || (card.dataset.search ?? "").includes(q);
        card.classList.toggle("hidden", !hit);
        if (hit) matches++;
      });
      noResults?.classList.toggle("hidden", matches > 0);
    };

    input?.addEventListener("input", apply);
    apply();
  });
</script>
