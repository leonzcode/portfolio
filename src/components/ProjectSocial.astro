---
/* Views and likes for one project, under its title.

   The counts live on the mlhub server (apps/mc/sitesocial.js), reached from
   the page itself, so the site stays static. A view is counted once a day
   for each visitor; a like is one each and the same button takes it back.
   Comments were taken off every project on 2026-11-06 (Leon). */
interface Props {
  /** "games/ski", "ai/avalanche": the category and the project's slug */
  slugKey: string;
}
const { slugKey } = Astro.props;
---

<div class="mt-5" data-social data-key={slugKey}>
  <div class="flex flex-wrap items-center gap-2 text-[13px]">
    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md border border-neutral-200 dark:border-neutral-800 text-neutral-600 dark:text-neutral-400" title="Views">
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
      <b data-views class="font-medium tabular-nums">–</b> <span class="sr-only">views</span>
    </span>
    <button type="button" data-like aria-pressed="false"
      class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md border border-neutral-200 dark:border-neutral-800 text-neutral-700 dark:text-neutral-300 hover:border-neutral-400 dark:hover:border-neutral-600 transition-colors aria-pressed:text-rose-600 aria-pressed:border-rose-300 dark:aria-pressed:border-rose-800">
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21s-7.5-4.6-9.6-9.2C.9 8.4 2.9 4.5 6.7 4.5c2.1 0 3.6 1.2 5.3 3.1 1.7-1.9 3.2-3.1 5.3-3.1 3.8 0 5.8 3.9 4.3 7.3C19.5 16.4 12 21 12 21Z"/></svg>
      <b data-likes class="font-medium tabular-nums">–</b> <span class="sr-only">likes</span>
    </button>
  </div>
</div>

<script>
  import { SITE_API as API, cachedEdits, rememberEdits, applyText } from "../scripts/siteedits";
  // one id a browser: what stops a like being counted twice. Not a login.
  function visitor(): string {
    try {
      let v = localStorage.getItem("siteVid");
      if (!v || !/^[a-z0-9]{8,40}$/.test(v)) {
        v = Array.from(crypto.getRandomValues(new Uint8Array(10)), (b) => b.toString(36).padStart(2, "0")).join("").slice(0, 20);
        localStorage.setItem("siteVid", v);
      }
      return v;
    } catch { return "anon" + Math.random().toString(36).slice(2, 12); }
  }
  const post = (path: string, body: object) =>
    fetch(API + path, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) }).then((r) => r.json());

  for (const root of document.querySelectorAll<HTMLElement>("[data-social]")) {
    const key = root.dataset.key!;
    const vid = visitor();
    const $ = <T extends HTMLElement>(s: string) => root.querySelector(s) as T;
    const likeBtn = $<HTMLButtonElement>("[data-like]");

    // the admin's title and description for this project, if there are any
    const showEdit = (e: any) => {
      applyText(key, e);
      const h = document.querySelector<HTMLElement>('h1[data-edit="title"][data-edit-key="' + key + '"]');
      if (h) document.title = (h.textContent || "").trim() + " · Leon Zhao";
    };
    showEdit(cachedEdits().text[key]);
    const setCounts = (j: any) => {
      if ("edit" in j) {
        showEdit(j.edit);
        const text: Record<string, any> = {};
        if (j.edit) text[key] = j.edit;
        rememberEdits([key], [], text, {});
      }
      if (typeof j.views === "number") $("[data-views]").textContent = String(j.views);
      if (typeof j.likes === "number") $("[data-likes]").textContent = String(j.likes);
      if (typeof j.liked === "boolean") likeBtn.setAttribute("aria-pressed", String(j.liked));
    };
    post("/view", { slug: key, vid }).then(setCounts).catch(() => {});

    likeBtn.addEventListener("click", () => {
      const on = likeBtn.getAttribute("aria-pressed") !== "true";
      likeBtn.setAttribute("aria-pressed", String(on));
      post("/like", { slug: key, vid, on }).then(setCounts).catch(() => {});
    });
  }
</script>
