---
import ThemeToggle from "./ThemeToggle.astro";

const navItems = [
  { href: "/", label: "About" },
  { href: "/ai", label: "AI" },
  { href: "/science", label: "Science" },
  { href: "/math", label: "Math" },
  { href: "/film", label: "Film" },
  { href: "/games", label: "Games" },
  { href: "/contact", label: "Contact" },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="flex items-center justify-between gap-4 mb-14">
  <a href="/" aria-label="Home" class="shrink-0 block">
    <img
      src="/logo.png"
      alt=""
      width="36"
      height="36"
      class="w-9 h-9 rounded-full"
    />
  </a>
  <nav class="flex items-center gap-1 sm:gap-2 text-[14px] font-medium">
    {
      navItems.map((item) => {
        const isActive =
          item.href === "/"
            ? currentPath === "/"
            : currentPath === item.href || currentPath.startsWith(item.href + "/");
        return (
          <a
            href={item.href}
            class:list={[
              "px-1.5 sm:px-2 py-1.5 rounded-md transition-colors",
              isActive
                ? "text-neutral-900 dark:text-neutral-50"
                : "text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100",
            ]}
            aria-current={isActive ? "page" : undefined}
          >
            {item.label}
          </a>
        );
      })
    }
  </nav>
  <ThemeToggle />
</header>
