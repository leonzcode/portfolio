# Local secrets for `npx wrangler pages dev` (the ChatGPT demo backend).
#
# HOW TO USE:
#   1. Copy this file to  .dev.vars  (no ".example")
#   2. Paste your real keys after each = sign
#   3. Run:  npx wrangler pages dev dist
#      (build first with `npm run build`, then open the printed localhost URL)
#
# .dev.vars is gitignored, so it stays on your machine and never gets pushed.
# This is LOCAL ONLY — the live site at leonzhao.dev reads its keys from the
# Cloudflare Pages dashboard (Settings -> Environment variables), not this file.

OPENAI_API_KEY=sk-proj-your-primary-key-here
OPENAI_API_KEY_2=sk-proj-your-second-key-here
OPENAI_API_KEY_3=sk-proj-your-third-key-here
OPENAI_API_KEY_4=sk-proj-your-fourth-key-here
OPENAI_API_KEY_5=sk-proj-your-fifth-key-here

# Optional — defaults to gpt-4o-mini if omitted
# OPENAI_MODEL=gpt-4o-mini
