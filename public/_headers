/mario/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Asset-Rule: mario

/gta/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Asset-Rule: gta

# /mario and /gta are hand-written module graphs with unhashed filenames. The
# page is always revalidated, its modules default to a four hour cache, and new
# HTML beside an old game.js is a page whose buttons the script has never heard
# of. If Pages honours the rule above the whole graph moves together; the ?v= on
# every import in those folders is what makes it true either way.
